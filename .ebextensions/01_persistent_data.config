# Creates the JSON store outside /var/app/current.
#
# Elastic Beanstalk replaces /var/app/current wholesale on every deploy, so
# anything written inside the app directory is lost. /opt/hrsage/data sits
# outside that tree and survives deploys. The DATA_DIR environment property
# on the environment points server.ts at it.
#
# Scope of this persistence: survives application deploys and app restarts.
# It does NOT survive instance replacement (environment rebuild, platform
# update that swaps instances, or autoscaling replacement), because it is
# instance-local EBS. Use EFS if you need durability beyond that.
commands:
  01_create_persistent_data_dir:
    command: "mkdir -p /opt/hrsage/data && chown -R webapp:webapp /opt/hrsage && chmod 755 /opt/hrsage/data"
